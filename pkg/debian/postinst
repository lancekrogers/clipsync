#!/bin/bash
set -e

case "$1" in
    configure)
        echo "ClipSync installed the user systemd unit at /usr/lib/systemd/user/clipsync.service."
        echo "After graphical login, enable it for your user session:"
        echo "  systemctl --user daemon-reload"
        echo "  systemctl --user enable --now clipsync"
        echo ""
        echo "If a legacy system-wide clipsync.service is still enabled, review it before disabling:"
        echo "  sudo systemctl status clipsync"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
