FROM rust:1.95-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev pkg-config libx11-dev libxcb1-dev libegl1-mesa-dev libgl1-mesa-dri \
    libxkbcommon-dev libxkbcommon-x11-0 libwayland-dev libxrandr-dev libxi-dev \
    libxcursor-dev libxinerama-dev xvfb xclip openssh-client python3 python3-msgpack \
    python3-pyte python3-gi desktop-file-utils libglib2.0-bin file \
    sway wl-clipboard dbus dbus-x11 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
